import 'package:flutter/material.dart';
import 'package:go_router/go_router.dart';
import 'package:intl/intl.dart';
import 'package:provider/provider.dart';
import 'package:shared_preferences/shared_preferences.dart';

import '../../../core/theme.dart';
import '../../../models/user_car.dart';
import '../../auth/providers/auth_provider.dart';
import '../../my_cars/providers/my_cars_provider.dart';
import '../data/booking_repository.dart';
import '../providers/booking_flow_provider.dart';

class BookingConfirmationScreen extends StatefulWidget {
  const BookingConfirmationScreen({super.key});

  @override
  State<BookingConfirmationScreen> createState() =>
      _BookingConfirmationScreenState();
}

class _BookingConfirmationScreenState
    extends State<BookingConfirmationScreen> {
  final _formKey = GlobalKey<FormState>();
  final _nameCtrl = TextEditingController();
  final _phoneCtrl = TextEditingController();
  bool _submitting = false;
  String? _submitError;
  String? _selectedCarId;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!mounted) return;
      final auth = context.read<AuthProvider>();
      final carsProvider = context.read<MyCarsProvider>();

      if (auth.isLoggedIn) {
        _nameCtrl.text = auth.user!.name;
        _phoneCtrl.text = auth.user!.phone ?? '';
        if (carsProvider.cars.isEmpty) {
          carsProvider.load();
        }
      }
    });
  }

  @override
  void dispose() {
    _nameCtrl.dispose();
    _phoneCtrl.dispose();
    super.dispose();
  }

  Future<void> _submit() async {
    if (!_formKey.currentState!.validate()) return;
    final flow = context.read<BookingFlowProvider>();
    final repo = context.read<BookingRepository>();
    final auth = context.read<AuthProvider>();

    final customerName = auth.isLoggedIn
        ? auth.user!.name
        : _nameCtrl.text.trim();

    setState(() {
      _submitting = true;
      _submitError = null;
    });
    try {
      flow.setCustomer(
        name: customerName,
        phone: _phoneCtrl.text.trim(),
      );
      flow.selectCar(_selectedCarId);
      await repo.createBooking(
        serviceId: flow.service!.id,
        specialistId: flow.specialist!.id,
        scheduledAt: flow.slot!.start,
        customerName: customerName,
        customerPhone: _phoneCtrl.text.trim(),
        carId: _selectedCarId,
      );
      final prefs = await SharedPreferences.getInstance();
      await prefs.setString('customer_phone', _phoneCtrl.text.trim());
      if (!mounted) return;
      context.go('/booking/success');
    } catch (e) {
      if (!mounted) return;
      setState(() => _submitError = e.toString());
    } finally {
      if (mounted) setState(() => _submitting = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final flow = context.watch<BookingFlowProvider>();
    final service = flow.service!;
    final specialist = flow.specialist!;
    final slot = flow.slot!;
    final dateLabel = DateFormat('d MMMM, EEEE', 'ru').format(slot.start);
    final auth = context.watch<AuthProvider>();
    final isLoggedIn = auth.isLoggedIn;

    final cars = isLoggedIn
        ? context.watch<MyCarsProvider>().cars
        : <UserCar>[];

    return Scaffold(
      appBar: AppBar(title: const Text('Подтверждение записи')),
      body: Form(
        key: _formKey,
        child: ListView(
          padding: const EdgeInsets.fromLTRB(20, 16, 20, 24),
          children: [
            Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: BrandColors.surfaceMuted,
                borderRadius: BorderRadius.circular(16),
              ),
              child: Column(
                children: [
                  _SummaryRow(label: 'Услуга', value: service.title),
                  _SummaryRow(label: 'Стоимость', value: service.priceLabel),
                  _SummaryRow(label: 'Длительность',
                      value: service.durationLabel),
                  _SummaryRow(label: 'Специалист',
                      value: specialist.fullName),
                  _SummaryRow(label: 'Дата', value: dateLabel),
                  _SummaryRow(label: 'Время', value: slot.label,
                      isLast: true),
                ],
              ),
            ),
            const SizedBox(height: 24),
            Text(
              isLoggedIn ? 'Ваши данные' : 'Ваши данные',
              style: const TextStyle(fontSize: 17, fontWeight: FontWeight.w600),
            ),
            const SizedBox(height: 12),
            if (isLoggedIn)
              Padding(
                padding: const EdgeInsets.only(bottom: 12),
                child: Row(
                  children: [
                    const Icon(Icons.person_outline,
                        size: 20, color: BrandColors.textSecondary),
                    const SizedBox(width: 8),
                    Text(
                      auth.user!.name,
                      style: const TextStyle(
                        fontSize: 16,
                        fontWeight: FontWeight.w500,
                      ),
                    ),
                  ],
                ),
              ),
            if (!isLoggedIn) ...[
              const SizedBox(height: 12),
              TextFormField(
                controller: _nameCtrl,
                decoration: const InputDecoration(hintText: 'Имя'),
                textInputAction: TextInputAction.next,
                validator: (v) =>
                    (v == null || v.trim().isEmpty) ? 'Введите имя' : null,
              ),
            ],
            const SizedBox(height: 12),
            TextFormField(
              controller: _phoneCtrl,
              decoration: const InputDecoration(hintText: 'Телефон'),
              keyboardType: TextInputType.phone,
              textInputAction: TextInputAction.done,
              validator: (v) {
                if (v == null || v.trim().length < 5) {
                  return 'Введите номер телефона';
                }
                return null;
              },
            ),
            if (isLoggedIn && cars.isNotEmpty) ...[
              const SizedBox(height: 20),
              const Text(
                'Автомобиль',
                style: TextStyle(fontSize: 17, fontWeight: FontWeight.w600),
              ),
              const SizedBox(height: 8),
              DropdownButtonFormField<String?>(
                value: _selectedCarId,
                decoration: const InputDecoration(
                  hintText: 'Выберите автомобиль',
                ),
                items: [
                  const DropdownMenuItem(
                    value: null,
                    child: Text('Без автомобиля'),
                  ),
                  ...cars.map(
                    (car) => DropdownMenuItem(
                      value: car.id,
                      child: Text(car.displayName),
                    ),
                  ),
                ],
                onChanged: (v) => setState(() => _selectedCarId = v),
              ),
            ],
            if (_submitError != null) ...[
              const SizedBox(height: 16),
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: BrandColors.orange.withValues(alpha: 0.10),
                  borderRadius: BorderRadius.circular(10),
                ),
                child: Text(
                  _submitError!,
                  style: const TextStyle(color: BrandColors.orange),
                ),
              ),
            ],
            const SizedBox(height: 28),
            ElevatedButton(
              onPressed: _submitting ? null : _submit,
              child: _submitting
                  ? const SizedBox(
                      width: 22,
                      height: 22,
                      child: CircularProgressIndicator(
                        strokeWidth: 2.4,
                        color: Colors.white,
                      ),
                    )
                  : const Text('Подтвердить запись'),
            ),
          ],
        ),
      ),
    );
  }
}

class _SummaryRow extends StatelessWidget {
  const _SummaryRow({
    required this.label,
    required this.value,
    this.isLast = false,
  });
  final String label;
  final String value;
  final bool isLast;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: EdgeInsets.only(bottom: isLast ? 0 : 10),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          SizedBox(
            width: 110,
            child: Text(
              label,
              style: const TextStyle(
                fontSize: 14,
                color: BrandColors.textSecondary,
              ),
            ),
          ),
          Expanded(
            child: Text(
              value,
              style: const TextStyle(
                fontSize: 14,
                fontWeight: FontWeight.w600,
              ),
            ),
          ),
        ],
      ),
    );
  }
}
