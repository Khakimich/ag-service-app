class BookingConfirmationScreen extends StatefulWidget {
  const BookingConfirmationScreen({super.key});

  @override
  State<BookingConfirmationScreen> createState() =>
      _BookingConfirmationScreenState();
}

class _BookingConfirmationScreenState
    extends State<BookingConfirmationScreen> {
  final _formKey = GlobalKey<FormState>();
  final _nameCtrl = TextEditingController();
  final _phoneCtrl = TextEditingController();
  bool _submitting = false;
  String? _submitError;
  String? _selectedCarId;

  bool _bookingAvailable = true;
  bool _checkingBookingAvailability = true;
  String _bookingUnavailableMessage = '';

  Future<void> _refreshBookingAvailability() async {

    try {

      final settings =
          await context.read<BookingRepository>().bookingSettings();

      if (!mounted) return;

      setState(() {
        _bookingAvailable =
            settings.bookingAvailable;

        _bookingUnavailableMessage =
            settings.message;

        _checkingBookingAvailability =
            false;
      });

    } catch (_) {

      if (!mounted) return;

      setState(() {
        _checkingBookingAvailability =
            false;
      });
    }
  }

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!mounted) return;
      _refreshBookingAvailability();

      final auth = context.read<AuthProvider>();
      final carsProvider = context.read<MyCarsProvider>();

      if (auth.isLoggedIn) {
        _nameCtrl.text = auth.user!.name;
        _phoneCtrl.text = auth.user!.phone ?? '';
        if (carsProvider.cars.isEmpty) {
          carsProvider.load();
        }
      }
    });
  }

  @override
  void dispose() {
    _nameCtrl.dispose();
    _phoneCtrl.dispose();
    super.dispose();
  }

  Future<void> _submit() async {
    if (!_formKey.currentState!.validate()) return;
    final flow = context.read<BookingFlowProvider>();
    final repo = context.read<BookingRepository>();
    final auth = context.read<AuthProvider>();

    try {
      final settings =
          await repo.bookingSettings();

      if (!settings.bookingAvailable) {

        if (!mounted) return;

        setState(() {
          _bookingAvailable = false;
          _bookingUnavailableMessage =
              settings.message;
          _submitError =
              settings.message.isNotEmpty
                  ? settings.message
                  : 'Онлайн-запись временно недоступна.';
        });

        return;
      }
    } catch (_) {
      // Сервер POST /api/bookings всё равно выполняет
      // окончательную проверку.
    }

    final customerName = auth.isLoggedIn
        ? auth.user!.name
        : _nameCtrl.text.trim();

    setState(() {
      _submitting = true;
      _submitError = null;
    });
    try {
      flow.setCustomer(
        name: customerName,
        phone: _phoneCtrl.text.trim(),
      );
      flow.selectCar(_selectedCarId);
      await repo.createBooking(
        serviceId: flow.service!.id,
        specialistId: flow.specialist!.id,
        scheduledAt: flow.slot!.start,
        customerName: customerName,
        customerPhone: _phoneCtrl.text.trim(),
        carId: _selectedCarId,
      );
      final prefs = await SharedPreferences.getInstance();
      await prefs.setString('customer_phone', _phoneCtrl.text.trim());
      if (!mounted) return;
      context.go('/booking/success');
    } catch (e) {
      if (!mounted) return;
      setState(() => _submitError = e.toString());
    } finally {
      if (mounted) setState(() => _submitting = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final flow = context.watch<BookingFlowProvider>();
    final service = flow.service!;
    final specialist = flow.specialist!;
    final slot = flow.slot!;
    final dateLabel = DateFormat('d MMMM, EEEE', 'ru').format(slot.start);
    final auth = context.watch<AuthProvider>();
    final isLoggedIn = auth.isLoggedIn;

    final cars = isLoggedIn
        ? context.watch<MyCarsProvider>().cars
        : <UserCar>[];

    return Scaffold(
      appBar: AppBar(title: const Text('РџРѕРґС‚РІРµСЂР¶РґРµРЅРёРµ Р·Р°РїРёСЃРё')),
      body: Form(
        key: _formKey,
        child: ListView(
          padding: const EdgeInsets.fromLTRB(20, 16, 20, 24),
          children: [

            if (!_checkingBookingAvailability &&
                !_bookingAvailable) ...[

              Container(
                width: double.infinity,
                padding: const EdgeInsets.all(14),
                decoration: BoxDecoration(
                  color: const Color(0xFFFFF2E8),
                  borderRadius: BorderRadius.circular(14),
                  border: Border.all(
                    color: const Color(0xFFFFC89F),
                  ),
                ),
                child: Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [

                    const Icon(
                      Icons.info_outline_rounded,
                      color: BrandColors.orange,
                    ),

                    const SizedBox(width: 10),

                    Expanded(
                      child: Column(
                        crossAxisAlignment:
                            CrossAxisAlignment.start,
                        children: [

                          const Text(
                            'Онлайн-запись недоступна',
                            style: TextStyle(
                              fontWeight: FontWeight.w800,
                            ),
                          ),

                          const SizedBox(height: 4),

                          Text(
                            _bookingUnavailableMessage.isNotEmpty
                                ? _bookingUnavailableMessage
                                : 'Попробуйте позже или свяжитесь с сервисом.',
                            style: const TextStyle(
                              fontSize: 13,
                              height: 1.35,
                            ),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),

              const SizedBox(height: 16),
            ],

            Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: BrandColors.surfaceMuted,
                borderRadius: BorderRadius.circular(16),
              ),
              child: Column(
                children: [
                  _SummaryRow(label: 'РЈСЃР»СѓРіР°', value: service.title),
                  _SummaryRow(label: 'РЎС‚РѕРёРјРѕСЃС‚СЊ', value: service.priceLabel),
                  _SummaryRow(label: 'Р”Р»РёС‚РµР»СЊРЅРѕСЃС‚СЊ',
                      value: service.durationLabel),
                  _SummaryRow(label: 'РЎРїРµС†РёР°Р»РёСЃС‚',
                      value: specialist.fullName),
                  _SummaryRow(label: 'Р”Р°С‚Р°', value: dateLabel),
                  _SummaryRow(label: 'Р’СЂРµРјСЏ', value: slot.label,
                      isLast: true),
                ],
              ),
            ),
            const SizedBox(height: 24),
            Text(
              isLoggedIn ? 'Р’Р°С€Рё РґР°РЅРЅС‹Рµ' : 'Р’Р°С€Рё РґР°РЅРЅС‹Рµ',
              style: const TextStyle(fontSize: 17, fontWeight: FontWeight.w600),
            ),
            const SizedBox(height: 12),
            if (isLoggedIn)
              Padding(
                padding: const EdgeInsets.only(bottom: 12),
                child: Row(
                  children: [
                    const Icon(Icons.person_outline,
                        size: 20, color: BrandColors.textSecondary),
                    const SizedBox(width: 8),
                    Text(
                      auth.user!.name,
                      style: const TextStyle(
                        fontSize: 16,
                        fontWeight: FontWeight.w500,
                      ),
                    ),
                  ],
                ),
              ),
            if (!isLoggedIn) ...[
              const SizedBox(height: 12),
              TextFormField(
                controller: _nameCtrl,
                decoration: const InputDecoration(hintText: 'РРјСЏ'),
                textInputAction: TextInputAction.next,
                validator: (v) =>
                    (v == null || v.trim().isEmpty) ? 'Р’РІРµРґРёС‚Рµ РёРјСЏ' : null,
              ),
            ],
            const SizedBox(height: 12),
            TextFormField(
              controller: _phoneCtrl,
              decoration: const InputDecoration(hintText: 'РўРµР»РµС„РѕРЅ'),
              keyboardType: TextInputType.phone,
              textInputAction: TextInputAction.done,
              validator: (v) {
                if (v == null || v.trim().length < 5) {
                  return 'Р’РІРµРґРёС‚Рµ РЅРѕРјРµСЂ С‚РµР»РµС„РѕРЅР°';
                }
                return null;
              },
            ),
            if (isLoggedIn && cars.isNotEmpty) ...[
              const SizedBox(height: 20),
              const Text(
                'РђРІС‚РѕРјРѕР±РёР»СЊ',
                style: TextStyle(fontSize: 17, fontWeight: FontWeight.w600),
              ),
              const SizedBox(height: 8),
              DropdownButtonFormField<String?>(
                value: _selectedCarId,
                decoration: const InputDecoration(
                  hintText: 'Р’С‹Р±РµСЂРёС‚Рµ Р°РІС‚РѕРјРѕР±РёР»СЊ',
                ),
                items: [
                  const DropdownMenuItem(
                    value: null,
                    child: Text('Р‘РµР· Р°РІС‚РѕРјРѕР±РёР»СЏ'),
                  ),
                  ...cars.map(
                    (car) => DropdownMenuItem(
                      value: car.id,
                      child: Text(car.displayName),
                    ),
                  ),
                ],
                onChanged: (v) => setState(() => _selectedCarId = v),
              ),
            ],
            if (_submitError != null) ...[
              const SizedBox(height: 16),
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: BrandColors.orange.withValues(alpha: 0.10),
                  borderRadius: BorderRadius.circular(10),
                ),
                child: Text(
                  _submitError!,
                  style: const TextStyle(color: BrandColors.orange),
                ),
              ),
            ],
            const SizedBox(height: 28),
            ElevatedButton(
              onPressed:
                  _submitting ||
                  _checkingBookingAvailability ||
                  !_bookingAvailable
                      ? null
                      : _submit,
              child: _submitting
                  ? const SizedBox(
                      width: 22,
                      height: 22,
                      child: CircularProgressIndicator(
                        strokeWidth: 2.4,
                        color: Colors.white,
                      ),
                    )
                  : const Text('РџРѕРґС‚РІРµСЂРґРёС‚СЊ Р·Р°РїРёСЃСЊ'),
            ),
          ],
        ),
      ),
    );
  }
}

class _SummaryRow extends StatelessWidget {
  const _SummaryRow({
    required this.label,
    required this.value,
    this.isLast = false,
  });
  final String label;
  final String value;
  final bool isLast;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: EdgeInsets.only(bottom: isLast ? 0 : 10),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          SizedBox(
            width: 110,
            child: Text(
              label,
              style: const TextStyle(
                fontSize: 14,
                color: BrandColors.textSecondary,
              ),
            ),
          ),
          Expanded(
            child: Text(
              value,
              style: const TextStyle(
                fontSize: 14,
                fontWeight: FontWeight.w600,
              ),
            ),
          ),
        ],
      ),
    );
  }
}

