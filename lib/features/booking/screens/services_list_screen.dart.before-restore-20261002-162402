  String get shortTitle {
    switch (title) {
      case 'Рулевое управление':
        return 'Рулевое\nуправление';
      case 'Техническое обслуживание':
        return 'Тех.\nобслуживание';
      case 'Тормозная система':
        return 'Тормозная\nсистема';
      default:
