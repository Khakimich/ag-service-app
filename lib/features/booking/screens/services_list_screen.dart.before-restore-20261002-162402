class _CategoryGrid extends StatelessWidget {
  const _CategoryGrid({
    required this.categories,
    required this.selectedCategory,
    required this.iconForCategory,
    required this.countForCategory,
    required this.onSelected,
  });
  final List<String> categories;
  final String selectedCategory;
  final String Function(String) iconForCategory;
  final int Function(String) countForCategory;
  final ValueChanged<String> onSelected;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.fromLTRB(18, 10, 18, 4),
      child: LayoutBuilder(
        builder: (context, c) {
          final columns = c.maxWidth >= 700 ? 5 : 4;
          const gap = 8.0;
          final w = (c.maxWidth - gap * (columns - 1)) / columns;
          return Wrap(
            spacing: gap,
            runSpacing: gap,
            children: [
              for (final category in categories)
                SizedBox(
                  width: w,
                  height: 126,
                  child: _CategoryTile(
                    title: category,
                    count: countForCategory(category),
                    iconAsset: iconForCategory(category),
                    selected: category == selectedCategory,
                    onTap: () => onSelected(category),
                  ),
                ),
            ],
          );
        },
      ),
    );
  }
}

class _CategoryTile extends StatelessWidget {
