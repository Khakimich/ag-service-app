                            color: Colors.transparent,
                            child: InkWell(
                              borderRadius: BorderRadius.circular(22),
                              onTap: _showAttachmentMenu,
                              child: Center(
                                child: SvgPicture.asset(
                                  'icons/chat/attach.svg',
