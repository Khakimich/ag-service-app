class ChatScreen extends StatefulWidget {
  const ChatScreen({
    super.key,
    required this.conversationId,
    this.conversation,
  });
  final String conversationId;
  final ChatConversation? conversation;

  @override
  State<ChatScreen> createState() => _ChatScreenState();
}

class _ChatScreenState extends State<ChatScreen> with WidgetsBindingObserver {
  static const _pollInterval = Duration(seconds: 6);

  final _messages = <ChatMessage>[];
  final _inputCtrl = TextEditingController();
  final _scrollCtrl = ScrollController();
  final _focusNode = FocusNode();
  final _picker = ImagePicker();

  // Voice recording
  final AudioRecorder _audioRecorder = AudioRecorder();
  final AudioPlayer _voicePreviewPlayer = AudioPlayer();

  StreamSubscription<Uint8List>? _voiceStreamSubscription;
  Timer? _voiceTimer;

  final List<int> _voicePcmBytes = <int>[];

  bool _isRecordingVoice = false;
  bool _isVoicePreviewPlaying = false;

  Duration _voiceRecordDuration = Duration.zero;
  Uint8List? _recordedVoiceBytes;

  Timer? _timer;
  bool _initialLoading = true;
  bool _sending = false;
  String? _error;
  XFile? _pickedImage;
  PlatformFile? _pickedFile;

  ChatMessage? _replyingTo;
  ChatMessage? _editingMessage;

  // ISO timestamp of the last message we received — used for incremental polling
  String? _lastTimestamp;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _loadInitial();
  }

  @override
  void dispose() {
    _timer?.cancel();
    _voiceTimer?.cancel();
    _voiceStreamSubscription?.cancel();
    _audioRecorder.dispose();
    _voicePreviewPlayer.dispose();
    WidgetsBinding.instance.removeObserver(this);
    _inputCtrl.dispose();
    _scrollCtrl.dispose();
    _focusNode.dispose();
    super.dispose();
  }

  // Stop polling when app goes to background; resume on foreground.
  // Prevents unnecessary network traffic and avoids waking Render's sleeping instance.
  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.paused ||
        state == AppLifecycleState.detached) {
      _timer?.cancel();
      _timer = null;
    } else if (state == AppLifecycleState.resumed && _timer == null) {
      _poll(); // immediate catch-up
      _startPolling();
    }
  }

  Future<void> _loadInitial() async {
    try {
      final msgs = await context.read<ChatRepository>().fetchMessages(
        widget.conversationId,
      );
      if (!mounted) return;
      setState(() {
        _messages.addAll(msgs);
        if (msgs.isNotEmpty) {
          _lastTimestamp = msgs.last.createdAt.toUtc().toIso8601String();
        }
        _initialLoading = false;
      });
      _scrollToBottom(animated: false);
      _startPolling();
    } catch (e) {
      if (!mounted) return;
      setState(() {
        _error = e.toString();
        _initialLoading = false;
      });
    }
  }

  void _startPolling() {
    _timer?.cancel();
    _timer = Timer.periodic(_pollInterval, (_) => _poll());
  }

  Future<void> _poll() async {
    if (!mounted) return;
    try {
      final newMsgs = await context.read<ChatRepository>().fetchMessages(
        widget.conversationId,
        after: _lastTimestamp,
      );
      if (!mounted || newMsgs.isEmpty) return;
      setState(() {
        final existingIds = _messages.map((m) => m.id).toSet();
        for (final msg in newMsgs) {
          if (!existingIds.contains(msg.id)) {
            _messages.add(msg);
          }
        }
        _lastTimestamp = newMsgs.last.createdAt.toUtc().toIso8601String();
      });
      _scrollToBottom();
    } catch (_) {
      // Polling errors are silent — next tick will retry.
    }
  }

  Future<void> _showMessageActions(ChatMessage message) async {
    if (message.isTemp || !mounted) return;

    final action = await showModalBottomSheet<String>(
      context: context,
      backgroundColor: Colors.transparent,
      useSafeArea: true,
      builder: (sheetContext) {
        return Container(
          margin: const EdgeInsets.all(10),
          padding: const EdgeInsets.symmetric(vertical: 8),
          decoration: BoxDecoration(
            color: BrandColors.surface,
            borderRadius: BorderRadius.circular(22),
          ),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              _MessageActionTile(
                icon: 'icons/chat/reply.svg',
                title: 'Ответить',
                onTap: () => Navigator.pop(sheetContext, 'reply'),
              ),
              if (!message.isDeleted && message.body.trim().isNotEmpty)
                _MessageActionTile(
                  icon: 'icons/chat/copy.svg',
                  title: 'Копировать',
                  onTap: () => Navigator.pop(sheetContext, 'copy'),
                ),
              if (message.isFromClient && !message.isDeleted)
                _MessageActionTile(
                  icon: 'icons/chat/edit.svg',
                  title: 'Редактировать',
                  onTap: () => Navigator.pop(sheetContext, 'edit'),
                ),
              if (!message.isDeleted)
                _MessageActionTile(
                  icon: 'icons/chat/pin.svg',
                  title: message.isPinned ? 'Открепить' : 'Закрепить',
                  onTap: () => Navigator.pop(sheetContext, 'pin'),
                ),
              _MessageActionTile(
                icon: 'icons/chat/delete.svg',
                title: 'Удалить',
                destructive: true,
                onTap: () => Navigator.pop(sheetContext, 'delete'),
              ),
            ],
          ),
        );
      },
    );

    if (!mounted || action == null) return;

    switch (action) {
      case 'copy':
        await Clipboard.setData(ClipboardData(text: message.body));
        if (!mounted) return;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Сообщение скопировано'),
            duration: Duration(seconds: 1),
          ),
        );
        break;

      case 'pin':
        await _toggleMessagePin(message);
        break;

      case 'delete':
        await _showDeleteMessageDialog(message);
        break;

      case 'reply':
        _startReply(message);
        break;

      case 'edit':
        _startEdit(message);
        break;
    }
  }

  Future<void> _toggleMessagePin(ChatMessage message) async {
    try {
      await context.read<ChatRepository>().togglePinMessage(
        widget.conversationId,
        message.id,
      );

      if (!mounted) return;

      await _refreshMessages();
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Не удалось изменить закрепление: $e')),
      );
    }
  }

  Future<void> _showDeleteMessageDialog(ChatMessage message) async {
    final action = await showModalBottomSheet<String>(
      context: context,
      backgroundColor: Colors.transparent,
      useSafeArea: true,
      builder: (sheetContext) {
        return Container(
          margin: const EdgeInsets.all(10),
          padding: const EdgeInsets.symmetric(vertical: 8),
          decoration: BoxDecoration(
            color: BrandColors.surface,
            borderRadius: BorderRadius.circular(22),
          ),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              _MessageActionTile(
                icon: 'icons/chat/delete.svg',
                title: 'Удалить у себя',
                destructive: true,
                onTap: () => Navigator.pop(sheetContext, 'me'),
              ),
              if (message.isFromClient)
                _MessageActionTile(
                  icon: 'icons/chat/delete.svg',
                  title: 'Удалить у всех',
                  destructive: true,
                  onTap: () => Navigator.pop(sheetContext, 'everyone'),
                ),
            ],
          ),
        );
      },
    );

    if (!mounted || action == null) return;

    try {
      if (action == 'me') {
        await context.read<ChatRepository>().deleteMessageForMe(
          widget.conversationId,
          message.id,
        );

        if (!mounted) return;

        setState(() {
          _messages.removeWhere((item) => item.id == message.id);
        });
      }

      if (action == 'everyone') {
        await context.read<ChatRepository>().deleteMessageForEveryone(
          widget.conversationId,
          message.id,
        );

        if (!mounted) return;

        await _refreshMessages();
      }
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Не удалось удалить сообщение: $e')),
      );
    }
  }

  Future<void> _refreshMessages() async {
    final messages = await context.read<ChatRepository>().fetchMessages(
      widget.conversationId,
    );

    if (!mounted) return;

    setState(() {
      _messages
        ..clear()
        ..addAll(messages);

      _lastTimestamp =
          messages.isEmpty
              ? null
              : messages.last.createdAt.toUtc().toIso8601String();
    });
  }

  void _startReply(ChatMessage message) {
    if (message.isDeleted) return;

    setState(() {
      _editingMessage = null;
      _replyingTo = message;
    });

    _focusNode.requestFocus();
  }

  void _startEdit(ChatMessage message) {
    if (message.isDeleted) return;

    setState(() {
      _replyingTo = null;
      _editingMessage = message;
      _inputCtrl.text = message.body;
      _inputCtrl.selection = TextSelection.collapsed(
        offset: _inputCtrl.text.length,
      );
    });

    _focusNode.requestFocus();
  }

  void _cancelReplyOrEdit() {
    setState(() {
      final wasEditing = _editingMessage != null;

      _replyingTo = null;
      _editingMessage = null;

      if (wasEditing) {
        _inputCtrl.clear();
      }
    });

    _focusNode.requestFocus();
  }

  Future<void> _pickImage() async {
    final image = await _picker.pickImage(
      source: ImageSource.gallery,
      maxWidth: 1024,
      maxHeight: 1024,
      imageQuality: 70,
    );
    if (image != null && mounted) {
      setState(() => _pickedImage = image);
    }
  }

  Future<void> _pickFile() async {
    final result = await FilePicker.platform.pickFiles(withData: true);
    if (result != null && result.files.isNotEmpty && mounted) {
      setState(() => _pickedFile = result.files.first);
    }
  }

  void _clearPickedFile() {
    setState(() => _pickedFile = null);
  }

  void _clearPickedImage() {
    setState(() {
      _pickedImage = null;
    });
  }

  Future<void> _send() async {
    final text = _inputCtrl.text.trim();

    final editing = _editingMessage;

    if (editing != null) {
      if (text.isEmpty || _sending) return;

      setState(() => _sending = true);

      try {
        final updated = await context.read<ChatRepository>().editMessage(
          widget.conversationId,
          editing.id,
          text,
        );

        if (!mounted) return;

        setState(() {
          final index = _messages.indexWhere((m) => m.id == updated.id);

          if (index != -1) {
            _messages[index] = updated;
          }

          _editingMessage = null;
          _replyingTo = null;
          _inputCtrl.clear();
        });
      } catch (e) {
        if (!mounted) return;

        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Не удалось изменить сообщение: $e')),
        );
      } finally {
        if (mounted) {
          setState(() => _sending = false);
        }
      }

      return;
    }

    final hasImage = _pickedImage != null;
    final hasFile = _pickedFile != null;
    if (text.isEmpty && !hasImage && !hasFile) return;
    if (_sending) return;

    String? photoBase64;
    if (hasImage) {
      final bytes = await _pickedImage!.readAsBytes();
      photoBase64 = base64Encode(bytes);
    }

    String? fileBase64;
    String? fileName;
    if (hasFile && _pickedFile!.bytes != null) {
      fileBase64 = base64Encode(_pickedFile!.bytes!);
      fileName = _pickedFile!.name;
    }

    final replyToSend = _replyingTo;

    final tempId = 'temp-${DateTime.now().millisecondsSinceEpoch}';
    final tempType =
        hasImage
            ? 'image'
            : (hasFile &&
                    (fileName?.endsWith('.mp4') == true ||
                        _pickedFile!.name.endsWith('.mp4') == true)
                ? 'video'
                : 'file');

    final tempMsg = ChatMessage(
      id: tempId,
      conversationId: widget.conversationId,
      senderRole: 'client',
      body:
          text.isNotEmpty
              ? text
              : (tempType == 'image'
                  ? 'Фото'
                  : tempType == 'video'
                  ? 'Видео'
                  : fileName ?? 'Файл'),
      createdAt: DateTime.now(),
      fileName: fileName,
      replyToId: replyToSend?.id,
      isTemp: true,
      uploading: true,
      tempType: tempType,
    );

    _inputCtrl.clear();
    final imageToSend = _pickedImage;
    final fileToSend = _pickedFile;
    setState(() {
      _sending = true;
      _pickedImage = null;
      _pickedFile = null;
      _replyingTo = null;
      _messages.add(tempMsg);
    });
    _scrollToBottom();

    try {
      if (!mounted) return;
      final msg = await context.read<ChatRepository>().sendMessage(
        widget.conversationId,
        body: text.isNotEmpty ? text : null,
        photoBase64: hasImage ? 'data:image/jpeg;base64,$photoBase64' : null,
        fileBase64:
            fileBase64 != null
                ? '${_mimeFromName(fileName ?? '')}base64,$fileBase64'
                : null,
        fileName: fileName,
        replyToId: replyToSend?.id,
      );
      if (!mounted) return;
      setState(() {
        final index = _messages.indexWhere((m) => m.id == tempId);
        if (index != -1) {
          _messages[index] = msg;
        } else {
          _messages.add(msg);
        }
        _lastTimestamp = msg.createdAt.toUtc().toIso8601String();
      });
      _scrollToBottom();
    } catch (e) {
      if (!mounted) return;
      setState(() {
        _messages.removeWhere((m) => m.id == tempId);
        _replyingTo = replyToSend;
      });
      if (text.isNotEmpty) _inputCtrl.text = text;
      if (imageToSend != null) _pickedImage = imageToSend;
      if (fileToSend != null) _pickedFile = fileToSend;
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text(e.toString())));
    } finally {
      if (mounted) setState(() => _sending = false);
    }
  }

  void _scrollToBottom({bool animated = true}) {
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!_scrollCtrl.hasClients) return;
      if (animated) {
        _scrollCtrl.animateTo(
          _scrollCtrl.position.maxScrollExtent,
          duration: const Duration(milliseconds: 300),
          curve: Curves.easeOut,
        );
      } else {
        _scrollCtrl.jumpTo(_scrollCtrl.position.maxScrollExtent);
      }
    });
  }

